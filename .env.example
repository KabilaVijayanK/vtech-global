# GEMINI_API_KEY: Required if optional AI features are enabled on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL used for canonical links, sitemap.xml, and OpenGraph metadata.
APP_URL="https://vtechmanufacturing.com"

# CRM_WEBHOOK_URL: Optional HubSpot, Zoho CRM, or Google Apps Script webhook endpoint for RFQ forwarding.
CRM_WEBHOOK_URL=""

# SALES_NOTIFICATION_EMAIL: Destination inbox for international RFQ alerts.
SALES_NOTIFICATION_EMAIL="exports@vtechmanufacturing.com"

# PUBLIC_WHATSAPP_NUMBER: International WhatsApp click-to-chat number (digits only).
VITE_WHATSAPP_NUMBER="914400000000"

# PUBLIC_CALENDLY_URL: Optional Calendly scheduling URL for "Talk to an Engineer".
VITE_CALENDLY_URL=""

# ANALYTICS: Optional GA4 & GTM IDs for conversion event tracking.
VITE_GA4_MEASUREMENT_ID=""
VITE_GTM_CONTAINER_ID=""

# HEADLESS_CMS: Optional Sanity or Strapi credentials when connecting external CMS.
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_TOKEN=""
